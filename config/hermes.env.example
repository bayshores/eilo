# Private destination: .state/hermes/.env (ignored; keep permissions 0600).
# Codex/ChatGPT OAuth is the current route; it does not use an API key here.
# Nebius is reserved for later, after access and allowed usage are confirmed.
NEBIUS_API_KEY=

# API access is separate from the Nebius key. API startup is deferred.
# Set a strong random local API key only when enabling the native gateway.
API_SERVER_KEY=
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8642
