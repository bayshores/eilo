#!/usr/bin/env python3
"""Chrome Native Messaging launcher for the local eïlo context broker."""
from __future__ import annotations

import asyncio
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from app.native_bridge import NativeBridgeError, run_native_host  # noqa: E402


def context_directory() -> Path:
    configured = os.environ.get("EILO_DATA_HOME")
    if configured:
        return Path(configured).expanduser() / "context"
    return ROOT / ".state" / "context"


def main() -> int:
    if len(sys.argv) != 2 or not sys.argv[1].startswith("chrome-extension://"):
        return 64
    try:
        asyncio.run(run_native_host(context_directory(), sys.argv[1]))
    except (NativeBridgeError, OSError, ValueError):
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
