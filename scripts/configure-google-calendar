#!/usr/bin/env python3
"""Import a developer-created Google Desktop OAuth client without printing its values."""
import json
from pathlib import Path
import re
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from app.persistence import write_private


def main():
    if len(sys.argv) != 2:
        raise ValueError("Usage: scripts/configure-google-calendar /path/to/downloaded-desktop-client.json")
    source = Path(sys.argv[1]).expanduser()
    if source.stat().st_size > 16384:
        raise ValueError("Choose a Google Desktop OAuth client JSON file.")
    client = json.loads(source.read_text()).get("installed")
    if not isinstance(client, dict) or not re.fullmatch(r"[0-9]+-[A-Za-z0-9_-]+\.apps\.googleusercontent\.com", client.get("client_id", "")):
        raise ValueError("Choose a Desktop app OAuth client, not a web or service-account credential.")
    saved = {"client_id": client["client_id"]}
    if "client_secret" in client:
        if not isinstance(client["client_secret"], str) or not 1 <= len(client["client_secret"]) <= 300:
            raise ValueError("The desktop client file is incomplete.")
        saved["client_secret"] = client["client_secret"]
    write_private(ROOT / ".state" / "google-calendar-client.json", saved)
    print("Google Calendar developer setup saved. Open Connections in felis to sign in.")


if __name__ == "__main__":
    try:
        main()
    except (ValueError, TypeError, OSError, AttributeError) as error:
        # Never print a credential, full input document, or raw filesystem error.
        print(str(error) if isinstance(error, ValueError) and not isinstance(error, json.JSONDecodeError)
              else "The Google client file could not be imported. Check the downloaded file and try again.", file=sys.stderr)
        raise SystemExit(1)
