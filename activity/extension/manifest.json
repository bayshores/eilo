{
  "manifest_version": 3,
  "name": "eïlo local activity context",
  "version": "0.1.0",
  "key": "",
  "description": "Shares only approved active study-site metadata with a local eïlo page after an explicit grant.",
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "eïlo activity context", "default_popup": "popup.html" },
  "optional_host_permissions": [
    "https://leetcode.com/*",
    "https://neetcode.io/*",
    "https://docs.python.org/*"
  ],
  "externally_connectable": { "matches": ["http://127.0.0.1/*"] }
}
