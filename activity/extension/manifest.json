{
  "manifest_version": 3,
  "name": "felis local activity context",
  "version": "0.2.2",
  "key": "",
  "description": "Connect browser context to felis with one permission. Shares active-site names and titles only while connected.",
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "felis activity context", "default_popup": "popup.html" },
  "options_ui": { "page": "popup.html", "open_in_tab": true },
  "permissions": ["storage", "nativeMessaging", "scripting"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "externally_connectable": { "matches": ["http://127.0.0.1/*"] }
}
